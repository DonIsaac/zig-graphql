{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "problemMatcher": "$zig",
            "command": "zig",
            "args": [
                "build",
                "--prominent-compile-errors"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "never", // shows up in problems tab
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "watch",
            "type": "shell",
            "problemMatcher": "$zig",
            "command": "zig",
            "args": [
                "build",
                "--prominent-compile-errors",
                "--watch"
            ],
            "group": "build",
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "never", // shows up in problems tab
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        },
    ]
}
